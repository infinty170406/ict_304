FROM eclipse-temurin:17-jdk-alpine AS build
WORKDIR /app

# Copy Maven wrapper scripts and dependencies
COPY .mvn/ .mvn
COPY mvnw pom.xml ./
COPY account-service/pom.xml account-service/pom.xml
COPY transaction-service/pom.xml transaction-service/pom.xml

RUN chmod +x mvnw

# Download dependencies for offline builds
RUN ./mvnw dependency:go-offline

# Copy the source code and build the application
COPY account-service/src ./account-service/src
COPY transaction-service/src ./transaction-service/src
RUN ./mvnw clean package -DskipTests

# Run stage
FROM eclipse-temurin:17-jre-alpine
WORKDIR /app

# Copy built artifact from the build stage
COPY --from=build /app/account-service/target/*.jar app.jar

# Start the application with memory limits for Render free tier
ENTRYPOINT ["java", "-Xmx256m", "-jar", "app.jar"]
